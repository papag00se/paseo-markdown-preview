{
  "name": "paseo-markdown-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Crossnote Markdown file previews with live updates and file-saving task checkboxes for Paseo Desktop.",
  "scripts": {
    "prepare": "node server/prepare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.ts",
    "preview": "tsx server/dev.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "crossnote": "0.9.31"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.1",
    "@getpaseo/plugin": "0.9.1",
    "@getpaseo/protocol": "0.9.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/vscode": "^1.140.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
